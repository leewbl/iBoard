{
  "schema": 1,
  "viewport": {
    "width": 960,
    "height": 430
  },
  "server": {
    "entry": "scripts/run-node-package-bin.mts",
    "args": [
      "vite",
      "preview",
      "/app/ui",
      "--host",
      "127.0.0.1",
      "--port",
      "5173",
      "--strictPort",
      "--configLoader",
      "runner"
    ],
    "port": 5173,
    "ready": "/control-ui-config.json"
  },
  "states": [
    {
      "id": "details-closed",
      "path": "/",
      "steps": [
        {
          "action": "text",
          "selector": ".login-gate__failure[data-kind=network] .login-gate__failure-title",
          "value": "Gateway unreachable"
        },
        {
          "action": "visible",
          "selector": ".login-gate__failure-detail:not([open]) > summary"
        },
        {
          "action": "hover",
          "selector": ".login-gate__failure-detail:not([open]) > summary"
        }
      ]
    },
    {
      "id": "details-open",
      "path": "/",
      "steps": [
        {
          "action": "text",
          "selector": ".login-gate__failure[data-kind=network] .login-gate__failure-title",
          "value": "Gateway unreachable"
        },
        {
          "action": "click",
          "selector": ".login-gate__failure-detail > summary"
        },
        {
          "action": "visible",
          "selector": ".login-gate__failure-detail[open] .login-gate__failure-raw"
        },
        {
          "action": "hover",
          "selector": ".login-gate__failure-detail[open] .login-gate__failure-raw"
        }
      ]
    }
  ]
}
